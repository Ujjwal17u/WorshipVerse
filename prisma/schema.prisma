generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Song {
  id        String       @id @default(cuid())
  title     String
  titleNorm String
  lyrics    String       @db.Text
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([titleNorm])
  @@index([title])
  @@index([titleNorm])
}
